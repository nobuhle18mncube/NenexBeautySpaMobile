<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Appointment">

    <LinearLayout
        android:id="@+id/form_layout"
        android:layout_width="460dp"
        android:layout_height="743dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.224"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Form Heading -->
        <TextView
            android:id="@+id/appointment_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingBottom="16dp"
            android:text="Create New Appointment"
            android:textColor="#524D4D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Client Name -->
        <EditText
            android:id="@+id/client_name_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Client Name"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080" />

        <!-- Stylist Name -->
        <EditText
            android:id="@+id/stylist_name_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Stylist Name"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080" />

        <!-- Appointment Date -->
        <EditText
            android:id="@+id/appointment_date_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Date (DD/MM/YYYY)"
            android:inputType="date"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080" />

        <!-- Contact -->
        <EditText
            android:id="@+id/contact_input"
            android:layout_width="422dp"
            android:layout_height="48dp"
            android:hint="Contact"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080" />

        <!-- Status -->
        <EditText
            android:id="@+id/status_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Status"
            android:inputType="text"
            android:textColor="@color/black"
            android:textColorHint="#808080" />

        <!-- View Appointments Button -->
        <Button
            android:id="@+id/save_appointment_button"
            android:layout_width="135dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="#C2185B"
            android:padding="12dp"
            android:text="SAVE"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/view_appointments_button"
            android:layout_width="135dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="#C2185B"
            android:padding="12dp"
            android:text="Search "
            android:textColor="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
